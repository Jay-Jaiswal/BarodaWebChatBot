# Gemini API configuration. Keep the real key in .env or your shell environment.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=data/chroma
TOP_K=4
# Optional cosine-distance cutoff; default is 0.70 for this prototype corpus.
# Calibrate on representative questions and documents.
RELEVANCE_THRESHOLD=0.70
# Disable optional Chroma telemetry for a quiet, local-only prototype.
ANONYMIZED_TELEMETRY=FALSE
